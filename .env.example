# Copy to `.env` and adjust if needed. Both keys have working defaults —
# `pnpm install && pnpm db:reset && pnpm dev` runs on a fresh clone without a
# `.env` file at all — but production must override `PULL_SERVER_SECRET`;
# `lib/env.ts` refuses to boot with the default value when
# `NODE_ENV=production`.

# A filesystem path, not a URL — better-sqlite3 takes a path. Gitignored
# (`/.data/`) and built by `pnpm db:seed`.
DATABASE_URL=./.data/beezie.db

# HMAC key for the pull commit-reveal scheme (lib/pull/fairness.ts). Must be
# at least 32 characters. The value below is a placeholder for local
# development only — generate a real secret for any deployed environment,
# e.g. `openssl rand -hex 32`.
PULL_SERVER_SECRET=dev-only-pull-server-secret-do-not-use-in-production!!

# The canonical origin, used by every canonical URL, og:url and the sitemap.
# Read at BUILD time: without it a production build ships localhost URLs. On
# Vercel the project URL is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=https://your-deploy-url.example.com
